---
interface Props {
  tags: Array<[tag: string, count: number]>;
  maxTags?: number;
}

const { tags, maxTags = 20 } = Astro.props;
const displayedTags = tags.slice(0, maxTags);
const hasMore = tags.length > maxTags;
---

<aside>
  <div class="sticky top-20">
    <h2 class="text-lg font-medium mb-4">Tags</h2>

    {displayedTags.length > 0 ? (
      <ul class="flex flex-wrap gap-2">
        {displayedTags.map(([tag]) => (
          <li>
            <a
              href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
              class="inline-flex items-center rounded-xl bg-(--color-surface) border border-(--color-border) px-2 py-1 text-sm text-(--color-muted) transition-all hover:bg-(--color-bg) hover:text-(--color-accent) no-underline"
            >
              {tag}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-(--color-muted) italic">No tags yet</p>
    )}

    {tags.length > 0 && (
      <div class="mt-4">
        <a
          href="/tags/"
          class="text-sm text-(--color-accent) hover:underline"
        >
          View all &rarr;
        </a>
      </div>
    )}
  </div>
</aside>
