---
import type { CollectionEntry } from 'astro:content';

interface Props {
  tags: Array<[tag: string, count: number]>;
  maxTags?: number;
}

const { tags, maxTags = 50 } = Astro.props;
const displayedTags = tags.slice(0, maxTags);
const hasMore = tags.length > maxTags;
---

<aside class="md:col-span-1">
  <div class="sticky top-6 rounded-lg border border-(--color-border) p-4 bg-(--color-surface)">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-(--color-muted) mb-4">
      Tags
    </h2>

    <div class="space-y-2">
      {displayedTags.map(([tag, count]) => (
        <a
          href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
          class="flex items-center justify-between gap-2 px-3 py-2 rounded-md text-sm hover:bg-(--color-muted)/20 transition-colors group"
        >
          <span class="text-(--color-primary) group-hover:text-(--color-accent)">
            {tag}
          </span>
          <span class="text-xs text-(--color-muted) bg-(--color-muted)/10 px-2 py-0.5 rounded group-hover:bg-(--color-accent)/10">
            {count}
          </span>
        </a>
      ))}
    </div>

    {hasMore && (
      <div class="mt-4 pt-4 border-t border-(--color-border)">
        <a
          href="/tags/"
          class="text-sm text-(--color-accent) hover:underline font-medium"
        >
          View all {tags.length} tags →
        </a>
      </div>
    )}

    {tags.length === 0 && (
      <p class="text-sm text-(--color-muted) italic">No tags yet</p>
    )}
  </div>
</aside>
