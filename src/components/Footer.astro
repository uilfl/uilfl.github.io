---
import { siteConfig } from '@/config';
---

<footer class="border-t border-(--color-border) mt-auto">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-sm text-(--color-muted)">
      <span>&copy; {new Date().getFullYear()} {siteConfig.author.name}</span>
      <span>
        Powered by <a href="https://astro.build" class="text-(--color-accent) hover:underline" target="_blank" rel="noopener">Astro</a>
      </span>
    </div>
  </div>
</footer>
