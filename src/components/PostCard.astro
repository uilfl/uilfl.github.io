---
import type { CollectionEntry } from 'astro:content';
import { getPostSlug, formatDate } from '@/lib/posts';

interface Props {
  post: CollectionEntry<'public'>;
}

const { post } = Astro.props;
const slug = getPostSlug(post);
---

<article class="group">
  <a href={`/${slug}/`} class="block py-4 -mx-2 px-2 rounded-md hover:bg-(--color-surface) transition-colors">
    <h3 class="text-lg font-semibold text-(--color-primary) group-hover:text-(--color-accent) transition-colors">
      {post.data.title}
    </h3>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1.5 text-sm text-(--color-muted)">
      {post.data.date && (
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      )}
      {post.data.categories.length > 0 && (
        <span>{post.data.categories.join(', ')}</span>
      )}
    </div>
    {post.data.excerpt && (
      <p class="mt-2 text-sm text-(--color-muted) line-clamp-2">{post.data.excerpt}</p>
    )}
  </a>
</article>
