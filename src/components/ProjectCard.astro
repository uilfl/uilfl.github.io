---
interface Props {
  title: string;
  description: string;
  url: string;
  image?: string;
}

const { title, description, url, image } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class="group block rounded-lg border border-(--color-border) overflow-hidden hover:shadow-md transition-shadow bg-(--color-bg)"
>
  {image ? (
    <div class="aspect-video overflow-hidden bg-(--color-surface)">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  ) : (
    <div class="aspect-video bg-(--color-surface) flex items-center justify-center">
      <svg class="w-10 h-10 text-(--color-border)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2"/>
        <line x1="8" y1="21" x2="16" y2="21"/>
        <line x1="12" y1="17" x2="12" y2="21"/>
      </svg>
    </div>
  )}
  <div class="p-4">
    <h3 class="font-semibold text-(--color-primary) group-hover:text-(--color-accent) transition-colors">
      {title}
    </h3>
    <p class="text-sm text-(--color-muted) mt-1 line-clamp-2">{description}</p>
  </div>
</a>
