---
interface Props {
  title: string;
  description: string;
  period: string;
  url?: string;
}

const { title, description, period, url } = Astro.props;
const Tag = url ? 'a' : 'div';
---

<Tag
  href={url || undefined}
  target={url ? '_blank' : undefined}
  rel={url ? 'noopener' : undefined}
  class:list={[
    'block p-4 rounded-lg border border-(--color-border) bg-(--color-bg)',
    url && 'hover:bg-(--color-surface) transition-colors cursor-pointer',
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h3 class="font-semibold text-(--color-primary)">{title}</h3>
      <p class="text-sm text-(--color-muted) mt-0.5">{description}</p>
    </div>
    <span class="text-xs text-(--color-muted) whitespace-nowrap mt-0.5">{period}</span>
  </div>
</Tag>
