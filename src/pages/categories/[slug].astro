---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getAllCategories, sortByDate } from '@/lib/posts';

export async function getStaticPaths() {
  const allPosts = sortByDate(await getCollection('public'));
  const categories = getAllCategories(allPosts);

  return [...categories.entries()].map(([category, posts]) => ({
    params: { slug: category.toLowerCase().replace(/\s+/g, '-') },
    props: { category, posts },
  }));
}

interface Props {
  category: string;
  posts: Awaited<ReturnType<typeof getCollection<'public'>>>;
}

const { category, posts } = Astro.props;
---

<BaseLayout title={category}>
  <h1 class="text-2xl font-bold mb-1">{category}</h1>
  <p class="text-sm text-(--color-muted) mb-6">{posts.length} post{posts.length !== 1 ? 's' : ''}</p>

  <div class="divide-y divide-(--color-border)">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
