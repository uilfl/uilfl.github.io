---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getAllTags, sortByDate } from '@/lib/posts';

export async function getStaticPaths() {
  const allPosts = sortByDate(await getCollection('public'));
  const tags = getAllTags(allPosts);

  return [...tags.entries()].map(([tag, posts]) => ({
    params: { slug: tag.toLowerCase().replace(/\s+/g, '-') },
    props: { tag, posts },
  }));
}

interface Props {
  tag: string;
  posts: Awaited<ReturnType<typeof getCollection<'public'>>>;
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`}>
  <h1 class="text-2xl font-bold mb-1">#{tag}</h1>
  <p class="text-sm text-(--color-muted) mb-6">{posts.length} post{posts.length !== 1 ? 's' : ''}</p>

  <div class="divide-y divide-(--color-border)">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
