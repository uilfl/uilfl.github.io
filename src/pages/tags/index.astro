---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortByDate, getUniqueTagsWithCount } from '@/lib/posts';

const allPosts = sortByDate(await getCollection('public'));
const tagsWithCount = getUniqueTagsWithCount(allPosts);
---

<BaseLayout title="All Tags">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold mb-2">All Tags</h1>
    <p class="text-(--color-muted) mb-8">
      Browse all {tagsWithCount.length} tags
    </p>

    {tagsWithCount.length > 0 ? (
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {tagsWithCount.map(([tag, count]) => (
          <a
            href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
            class="group flex items-center justify-between gap-3 px-4 py-3 rounded-lg border border-(--color-border) hover:border-(--color-accent) hover:bg-(--color-surface) transition-colors"
          >
            <span class="text-(--color-primary) group-hover:text-(--color-accent)">
              {tag}
            </span>
            <span class="text-xs text-(--color-muted) bg-(--color-muted)/10 px-2 py-0.5 rounded group-hover:bg-(--color-accent)/10 group-hover:text-(--color-accent)">
              {count}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-(--color-muted) text-center py-12">
        No tags found.
      </p>
    )}
  </div>
</BaseLayout>
