---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="text-center py-16">
    <h1 class="text-6xl font-bold text-(--color-muted)">404</h1>
    <p class="mt-4 text-lg text-(--color-muted)">Page not found.</p>
    <a href="/" class="inline-block mt-6 text-(--color-accent) hover:underline">
      Back to home
    </a>
  </div>
</BaseLayout>
