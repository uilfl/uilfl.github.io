---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroCard from '@/components/HeroCard.astro';
import PostCard from '@/components/PostCard.astro';
import EducationCard from '@/components/EducationCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { siteConfig } from '@/config';
import { getCollection } from 'astro:content';
import { sortByDate } from '@/lib/posts';

const allPosts = sortByDate(await getCollection('public'));
const recentPosts = allPosts.slice(0, 5);
const { author, education, projects } = siteConfig;
---

<BaseLayout>
  <!-- Hero -->
  <HeroCard />

  <!-- About -->
  <section class="mt-12">
    <div class="flex items-baseline justify-between gap-4 flex-wrap">
      <h2 class="text-xl sm:text-2xl font-bold text-(--color-primary)">About</h2>
      <a href="/about/" class="text-sm sm:text-base text-(--color-accent) hover:underline">
        More about me &rarr;
      </a>
    </div>
    <div class="mt-4 rounded-2xl border border-(--color-border) bg-(--color-surface) p-5 sm:p-6">
      <p class="text-base sm:text-lg text-(--color-muted) leading-relaxed max-w-prose">
        {author.bio}
      </p>
      <div class="mt-4 flex items-center gap-2 text-sm sm:text-base text-(--color-muted)">
        <span class="font-medium text-(--color-primary)">{author.tagline}</span>
        <span aria-hidden="true">·</span>
        <span>{author.location}</span>
      </div>
    </div>
  </section>

  <!-- Posts -->
  <section class="mt-10">
    <h2 class="text-lg font-bold text-(--color-primary) mb-3">Posts</h2>
    {recentPosts.length === 0 ? (
      <p class="text-sm text-(--color-muted) py-4">No posts yet.</p>
    ) : (
      <ul class="space-y-0.5">
        {recentPosts.map((post) => (
          <PostCard post={post} compact />
        ))}
      </ul>
    )}
    {allPosts.length > 5 && (
      <a href="/blog/" class="inline-block mt-3 text-sm text-(--color-accent) hover:underline">
        More posts &rarr;
      </a>
    )}
  </section>

  <!-- Education -->
  {education.length > 0 && (
    <section class="mt-10">
      <h2 class="text-lg font-bold text-(--color-primary) mb-3">Education</h2>
      <div class="space-y-3">
        {education.map((item) => (
          <EducationCard
            title={item.title}
            description={item.description}
            period={item.period}
            url={item.url || undefined}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Projects -->
  {projects.length > 0 && (
    <section class="mt-10">
      <h2 class="text-lg font-bold text-(--color-primary) mb-3">Projects</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {projects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            url={project.url}
            image={project.image || undefined}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
