---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Masthead from '@/components/Masthead.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime?: string;
    tags?: string[];
  };
}

const { title, description, image, article } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <SEO title={title} description={description} image={image} article={article} />
  </head>
  <body class="min-h-screen flex flex-col bg-(--color-bg) text-(--color-primary)">
    <Masthead />
    <main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 py-8" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
